RedirectMatch 301 "^(/zh)?/docs/ingress-controller/(?:[01]\.\d+\.\d+/)?references/(.+)$" "$1/docs/ingress-controller/reference/apisix-ingress-controller/api-reference/"
RedirectMatch 301 "^(/zh)?/docs/ingress-controller/(?:[01]\.\d+\.\d+/)?tutorials/proxy-the-httpbin-service(-with-ingress)?/?$" "$1/docs/ingress-controller/getting-started/configure-routes/"
