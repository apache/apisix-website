---
import EcosystemArticlePage from '../../../components/EcosystemArticlePage.astro';
import { getCookbooks } from '../../../lib/ecosystem';

export function getStaticPaths() {
  return getCookbooks('zh').map((resource) => ({ params: { slug: resource.slug }, props: { resource } }));
}

const { resource } = Astro.props;
---
<EcosystemArticlePage locale="zh" resource={resource} />
